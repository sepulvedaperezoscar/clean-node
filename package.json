{
    "name": "rest-clean-node",
    "version": "0.0.1",
    "description": "Clean Architecture REST API with Node.js using TypeScript",
    "main": "dist/application/server.js",
    "scripts": {
        "dev": "tsx watch src/application/server.ts",
        "build": "tsc",
        "start": "node dist/application/server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src//*.ts",
        "lint:fix": "eslint src//*.ts --fix",
        "format": "prettier --write \"src//*.ts\""
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.27"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.10.5",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "prettier": "^3.1.1",
        "ts-jest": "^29.1.1",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    },
    "keywords": [
        "clean-architecture",
        "postgresql",
        "nodejs"
    ],
    "author": "Sepulveda Perez Oscar",
    "license": "MIT"
}
