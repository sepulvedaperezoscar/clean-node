# Entorno de ejemplo para clean-node
# Copia este archivo a `.env` y ajusta los valores según tu entorno.

# Entorno de ejecución
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clean_node_db
DB_USER=postgres
DB_PASSWORD=postgres

# Opcional: configuración para usar Docker local o CI
# POSTGRES_IMAGE=postgres:15-alpine
# POSTGRES_VOLUME=clean_node_db_data

# Notas:
# - Cambia las credenciales y el host en producción.
# - Si usas Docker Compose, asegúrate de que DB_HOST apunte al servicio correcto (p. ej. "db").
