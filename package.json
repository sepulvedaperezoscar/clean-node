{
    "name": "rest-clean-node",
    "version": "0.0.1",
    "description": "Clean Architecture REST API with Node.js using TypeScript",
    "main": "dist/application/server.js",
    "scripts": {
        "dev": "tsx watch src/application/server.ts",
        "build": "rimraf dist && tsc -p tsconfig.build.json",
        "start": "node dist/application/server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.21.2",
        "express-validator": "^7.3.0",
        "helmet": "^8.1.0",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.27"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.19.24",
        "@types/pg": "^8.15.6",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "eslint": "^8.57.1",
        "jest": "^29.7.0",
        "prettier": "^3.6.2",
        "rimraf": "^6.1.0",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "keywords": [
        "clean-architecture",
        "postgresql",
        "nodejs"
    ],
    "author": "Sepulveda Perez Oscar",
    "license": "MIT"
}